{
  "expo": {
    "name": "WhatsApp AI Client",
    "slug": "whatsapp-ai-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#075E54"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#075E54"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.vaibhav_963.whatsappaiclient"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow $(PRODUCT_NAME) to read your phonebook so chat names match your saved contacts."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "00085f33-d6fe-4c27-9a24-0e885c10fbfc"
      }
    }
  }
}
