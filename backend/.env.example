# Copy to .env and fill in. Never commit .env.
DATABASE_URL="mongodb://localhost:27017/vai4?replicaSet=rs0"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV="production"

# AI provider (OpenRouter). Server-side only; never expose to the frontend.
OPENROUTER_API_KEY=""

# Timezone used to resolve "today", "tomorrow", "Monday" in messages
APP_TIMEZONE="Asia/Kolkata"
