# Copy to .env and fill in. Never commit .env.
# Use MongoDB Atlas or a local replica set. The local start_db.js setup uses port 27018.
DATABASE_URL="mongodb://127.0.0.1:27018/vai4?replicaSet=rs0"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV="production"

# AI provider (OpenRouter). Server-side only; never expose to the frontend.
OPENROUTER_API_KEY=""

# Timezone used to resolve "today", "tomorrow", "Monday" in messages
APP_TIMEZONE="Asia/Kolkata"
